# ===== DB =====
# compose.yaml의 MySQL도 DB_USERNAME, DB_PASSWORD, MYSQL_ROOT_PASSWORD를 그대로 사용한다
DB_URL=jdbc:mysql://localhost:3307/our_marble?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=our_marble
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
# 로컬은 update (서버를 다시 켜도 데이터 유지), 처음부터 다시 만들려면 create-drop
DDL_AUTO=update

# ===== JWT =====
# 32바이트 이상 Base64 문자열 (예: openssl rand -base64 32)
JWT_SECRET=change-me

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== 메일 =====
# 로컬은 Mailpit (compose.yaml), 받은 메일은 http://localhost:8025 에서 확인
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@our-marble.local